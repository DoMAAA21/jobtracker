# Copy to .env at repo root: cp .env.example .env

# PostgreSQL
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker
POSTGRES_PORT=5432

# Prisma / API (host `postgres` is the Docker service name)
DATABASE_URL=postgresql://jobtracker:jobtracker@postgres:5432/jobtracker?schema=public

# pgAdmin — http://localhost:5050 (use a real-looking domain; .local is rejected)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# API — http://localhost:3000
API_PORT=3000
# Comma-separated if you use both localhost and 127.0.0.1 in the browser
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Client — http://localhost:5173
# Browser calls the API on the host, not the internal Docker hostname.
CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000
